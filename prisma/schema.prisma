generator client {
  provider = "prisma-client"
  output   = "./migrations/"
}

datasource db {
  provider = "postgresql"
}


enum PersonType {
  client
  shishya
  patient
  friend
  other
}

enum InteractionType {
  conversation
  advice
  meeting
  treatment
  proposal
  session
}

enum CaseCategory {
  health
  astrology
  business
  spiritual
}

enum CaseStatus {
  active
  resolved
  monitoring
}

enum CommitmentStatus {
  pending
  done
  missed
}

enum TaskStatus {
  pending
  done
  snoozed
}


model User {
  id        String   @id @default(uuid())
  name      String?
  email     String   @unique
  phone     String?  @unique
  password  String
  createdAt DateTime @default(now())

  persons      Person[]
  interactions Interaction[]
  commitments  Commitment[]
  cases        Case[]
  tasks        Task[]
}

model Person {
  id     String     @id @default(uuid())
  userId String
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name  String
  type  PersonType?
  phone String?
  email String?
  summary String?
  tags  String[]

  createdAt DateTime @default(now())

  interactions Interaction[]
  commitments  Commitment[]
  cases        Case[]
  tasks        Task[]

  @@index([userId])
  @@index([userId, name])
}

model Interaction {
  id       String @id @default(uuid())
  userId   String
  personId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  interactionType       InteractionType?
  notes      String?
  audioUrl   String?
  transcript String?
  interactionDate DateTime  @default(now())
  createdAt       DateTime  @default(now())
  commitments Commitment[]
  @@index([personId, interactionDate(sort: Desc)])
  @@index([userId])
}

model Commitment {
  id            String  @id @default(uuid())
  userId        String
  personId      String
  interactionId String?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  person      Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  interaction Interaction? @relation(fields: [interactionId], references: [id], onDelete: SetNull)

  title   String
  dueDate DateTime
  status  CommitmentStatus @default(pending)

  createdAt DateTime @default(now())

  @@index([userId, dueDate])
  @@index([userId, status])
}

model Case {
  id       String @id @default(uuid())
  userId   String
  personId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  category         CaseCategory?
  problem          String?
  diagnosis        String?
  suggestedActions String?

  followUpDate DateTime?
  status       CaseStatus @default(active)

  createdAt DateTime @default(now())

  tasks Task[]

  @@index([userId, status])
  @@index([userId, followUpDate])
}

model Task {
  id       String  @id @default(uuid())
  userId   String
  personId String?
  caseId   String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  person Person? @relation(fields: [personId], references: [id], onDelete: SetNull)
  case   Case?   @relation(fields: [caseId], references: [id], onDelete: SetNull)

  title      String
  remindAt   DateTime
  status     TaskStatus @default(pending)

  createdAt DateTime @default(now())

  @@index([userId, remindAt])
  @@index([userId, status])
}