generator client {
  provider = "prisma-client"
  output   = "./migrations/"
}

datasource db {
  provider = "postgresql"
}

enum ClientType {
  consulting_client
  retained_client
  one_time_client
  lead
  other
}

enum UserType{
  it
  healthcare
  realestate
  legal
  other
}

enum ClientStatus {
  active
  inactive
  archived
}

enum InteractionType {
  consulation
  meeting
  call
  treatment_session
  review_meeting
  project_discussion 
  support_call
}

enum TaskPriority {
  low
  medium
  high
  critical
}
enum TaskStatus {
  pending
  in_progress
  done
  overdue
}
enum AppointmentType {
  consultation
  follow_up
  review
  onboarding
  other
}
enum MeetingMode {
  in_person
  phone
  video
  other
}
enum AppointmentStatus {
  scheduled
  completed
  rescheduled
  cancelled
  missed
}
enum AuditAction {
  created
  updated
  deleted
}

enum AuditRecordType {
  client
  interaction
  task
  appointment
}

enum CaseStatus {
  active
  resolved
  monitoring
}

enum CommitmentStatus {
  pending
  done
  missed
}


model User {
  id        String   @id @default(uuid())
  name      String?  
  dob       DateTime
  type      UserType @default(it)
  email     String   @unique
  phone     String  @unique
  nameOfConsultancy String
  address   String
  password String
  createdAt DateTime @default(now())
  

  clients Client[]
  interactions Interaction[]
  commitments  Commitment[]
  appointments Appointment[]
  auditLogs AuditLog[]
  cases Case[]
  tasks Task[]
}


model Client{
  id     String     @id @default(uuid())
  userId String
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  name  String
  email String
  phone String
  companyName String?
  type  ClientType?
  status ClientStatus? @default(active)
  tags  String[] @default([])
  address String
  dob DateTime
  internalNotes String[] @default([])
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interactions Interaction[]
  tasks        Task[]
  appointments Appointment[]
  attachments Attachment[]
  commitments  Commitment[]
  cases        Case[]

  @@index([userId, name])
  @@index([userId, email])
  @@index([userId, status])
  @@index([id, status])
}


model Appointment{
  id String @id @default (uuid())
  userId String
  clientId String

  user User @relation(fields: [userId],references:[id], onDelete:Cascade)
  client Client @relation(fields: [clientId],references:[id], onDelete:Cascade)

  appointmentType AppointmentType
  appointmentDate DateTime
  duration Int
  meetingMode MeetingMode
  appointmentStatus AppointmentStatus @default(scheduled)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId,appointmentDate])
  @@index([clientId, appointmentDate])
  @@index([userId,appointmentStatus])
}


model Attachment{
  id String @id @default(uuid())
  userId        String?  // Uploader (internal)

  clientId      String?  // Client owner
  interactionId String?  // Related interaction
  taskId String?

  client        Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  interaction   Interaction? @relation(fields: [interactionId], references: [id], onDelete: Cascade)
  task          Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  fileName      String
  fileType      String   // pdf | png | jpg | jpeg | docx
  fileUrl       String
  fileSize      Int?     // bytes

  createdAt     DateTime @default(now())

  @@index([clientId])
  @@index([interactionId])
  @@index([taskId])
}

model Interaction {
  id       String @id @default(uuid())
  userId   String
  clientId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  interactionType       InteractionType?
  notes      String?
  audioUrl   String?
  transcript String?
  interactionDate DateTime  @default(now())
  commitments Commitment[]
  attachments Attachment[]
  @@index([clientId, interactionDate(sort: Desc)])
  @@index([userId])
}

model Commitment {
  id            String  @id @default(uuid())
  userId        String
  clientId      String
  interactionId String?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  interaction Interaction? @relation(fields: [interactionId], references: [id], onDelete: SetNull)

  title   String
  dueDate DateTime
  status  CommitmentStatus @default(pending)

  createdAt DateTime @default(now())

  @@index([userId, dueDate])
  @@index([userId, status])
}

model Case {
  id       String @id @default(uuid())
  userId   String
  clientId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  problem          String?
  diagnosis        String?
  suggestedActions String?

  followUpDate DateTime?
  status       CaseStatus @default(active)

  createdAt DateTime @default(now())

  tasks Task[]

  @@index([userId, status])
  @@index([userId, followUpDate])
}

model Task {
  id       String  @id @default(uuid())
  userId   String
  clientId String?
  caseId   String?
  
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  case   Case?   @relation(fields: [caseId], references: [id], onDelete: SetNull)

  title      String
  remindAt   DateTime
  status     TaskStatus @default(pending)

  createdAt DateTime @default(now())

  attachments Attachment[]

  @@index([userId, remindAt])
  @@index([userId, status])
}

model AuditLog {
  id         String          @id @default(uuid())
  userId     String?         // Null if system-triggered (e.g. overdue automation)
  user       User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  recordType AuditRecordType
  recordId   String
  action     AuditAction
  before     Json?           // State snapshot before change
  after      Json?           // State snapshot after change

  timestamp  DateTime        @default(now())

  @@index([recordType, recordId])
  @@index([userId, timestamp])
}